{
  "openapi": "3.1.0",
  "info": {
    "title": "VTH Training API",
    "version": "2.1.0",
    "description": "V-NAND VTH graph images, separate standardized/source previews, and browser-extracted shape descriptors for incremental similarity retrieval. Loopback mode works without authentication by default. A non-loopback bind automatically enables an access key; use x-api-key or Bearer authentication for API clients, or open the server-provided access_token URL once to establish the HttpOnly browser cookie."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4173",
      "description": "Default Windows/Linux loopback service"
    },
    {
      "url": "http://{host}:{port}",
      "description": "Ubuntu LAN or externally routed service",
      "variables": {
        "host": {
          "default": "192.168.1.10",
          "description": "Concrete LAN/public host. Never use 0.0.0.0 as a client URL."
        },
        "port": {
          "default": "4173"
        }
      }
    }
  ],
  "paths": {
    "/api/v1/similarity-search": {
      "get": {
        "summary": "Check the offline image similarity-search API",
        "responses": {
          "200": {
            "description": "Supported inputs, limits, bundled corpus count, and offline policy"
          }
        }
      },
      "post": {
        "summary": "Return ranked VTH shape matches for every chart and color series in one PNG or JPEG image",
        "description": "Charts at different coordinates are detected and cropped in reading order. Multiple full-width waveform series inside one physical chart are temporarily separated by color, normalized without color/style features, and ranked independently in panel.series. Text, tables, empty axes, rectangles, and explanatory diagrams without a coherent distribution waveform are excluded; a request with no distribution waveform returns 422 distribution_waveform_not_found. The legacy panel query/results mirror its representative most-irregular series, and the top-level query/results mirror panel 0's representative series. The query image is processed in memory only and is not saved or used for training. Results include normalized score components and request-origin URLs for the standardized curve and, when available, its original source preview. Authentication is required when VTH_API_KEY is configured or the service is bound to a non-loopback host.",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "name": "topK",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "default": 8
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/png": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "image/jpeg": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["image"],
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary"
                  },
                  "topK": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["imageDataUrl"],
                "properties": {
                  "imageDataUrl": {
                    "type": "string",
                    "description": "data:image/png;base64,... or data:image/jpeg;base64,..."
                  },
                  "topK": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked matching distributions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimilaritySearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/RequestError"
          },
          "401": {
            "description": "An API key or bootstrap browser cookie is required for a configured key or network-accessible bind"
          },
          "413": {
            "$ref": "#/components/responses/RequestError"
          },
          "415": {
            "$ref": "#/components/responses/RequestError"
          },
          "422": {
            "$ref": "#/components/responses/RequestError"
          },
          "500": {
            "$ref": "#/components/responses/RequestError"
          }
        }
      }
    },
    "/api/v1/runtime": {
      "get": {
        "summary": "Verify the standalone offline runtime policy",
        "responses": {
          "200": {
            "description": "Bundled components and external-network policy"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "Check local service and writable training store",
        "responses": {
          "200": {
            "description": "Service health and training counts"
          }
        }
      }
    },
    "/api/v1/training-samples": {
      "get": {
        "summary": "List search-ready learned candidates",
        "description": "Authentication is required when the server is bound to a non-loopback host.",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Ready candidates"
          },
          "401": {
            "description": "Network-accessible training storage requires an API key or bootstrap browser cookie"
          }
        }
      },
      "post": {
        "summary": "Verify a source waveform and add a server-authoritative learned sample",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrainingSampleInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Immediately search-ready sample whose profile, descriptor, State, and standardized SVG were regenerated from sourceImageDataUrl"
          },
          "400": {
            "description": "Malformed JSON, profile, descriptor, ID, image data URL, or missing sourceImageDataUrl"
          },
          "413": {
            "description": "JSON request exceeds 20MB or a decoded training image exceeds 12MB"
          },
          "415": {
            "description": "Content-Type must be application/json"
          },
          "422": {
            "description": "The source image is not one isolated distribution waveform or does not match the submitted profile"
          },
          "503": {
            "description": "The source-authoritative waveform validator is unavailable"
          },
          "401": {
            "description": "A configured or automatically generated API key is required"
          }
        }
      }
    },
    "/api/v1/training-images": {
      "post": {
        "summary": "Push a raw PNG/JPEG/WEBP image for later feature extraction",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "label",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "image/png": {},
            "image/jpeg": {},
            "image/webp": {},
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "imageDataUrl"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "imageDataUrl": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Image stored with pending status"
          },
          "201": {
            "description": "Search-ready when profile and descriptor are also provided"
          },
          "400": {
            "description": "Malformed JSON, image data URL, profile, descriptor, ID, or ready-mode sourceImageDataUrl"
          },
          "413": {
            "description": "Request body exceeds 12MB for raw images or 20MB for JSON, or a decoded image exceeds 12MB"
          },
          "415": {
            "description": "Content-Type must be image/png, image/jpeg, image/webp, or application/json"
          },
          "422": {
            "description": "Ready-mode source image is not one isolated distribution waveform or does not match the submitted profile. Raw image-only uploads remain pending."
          },
          "503": {
            "description": "The source-authoritative waveform validator is unavailable for JSON ready mode"
          },
          "401": {
            "description": "A configured or automatically generated API key is required"
          }
        }
      }
    },
    "/api/v1/training-samples/{id}": {
      "get": {
        "summary": "Get one learned or pending sample",
        "description": "Authentication is required when the server is bound to a non-loopback host.",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SampleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Sample metadata"
          },
          "401": {
            "description": "Network-accessible training storage requires authentication"
          }
        }
      },
      "delete": {
        "summary": "Delete a learned sample and its image",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SampleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted"
          },
          "401": {
            "description": "A configured or automatically generated API key is required"
          }
        }
      }
    },
    "/api/v1/training-samples/{id}/source-image": {
      "get": {
        "summary": "Get the stored original preview for a learned sample",
        "description": "Authentication is required when the server is bound to a non-loopback host.",
        "security": [
          {},
          {
            "apiKeyHeader": []
          },
          {
            "bearerAuth": []
          },
          {
            "browserCookie": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SampleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Metadata-free source preview"
          },
          "404": {
            "description": "Source preview not found"
          },
          "401": {
            "description": "Network-accessible training storage requires authentication"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Preferred for scripts and service integrations. Use VTH_API_KEY or the key printed when a non-loopback server starts."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "VTH API key",
        "description": "Send Authorization: Bearer <API key>."
      },
      "browserCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "vth_access",
        "description": "HttpOnly SameSite=Strict cookie established by opening a server-provided ?access_token=<API key> URL. The server immediately removes the token with a 303 redirect."
      }
    },
    "responses": {
      "RequestError": {
        "description": "Request, input decoding, resource-limit, or waveform-detection error. Existing error.code values remain stable; reasonCode and details provide additive diagnostics.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "parameters": {
      "SampleId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "SimilaritySearchResponse": {
        "type": "object",
        "required": ["schemaVersion", "requestId", "service", "inputHandling", "warnings", "privacy", "model", "query", "candidateCount", "matchedCandidateCount", "processingMs", "results", "panelCount", "panelLayout", "panelDetection", "panels"],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "requestId": {
            "type": "string"
          },
          "service": {
            "type": "string",
            "const": "vth-similarity-search-api"
          },
          "inputHandling": {
            "type": "object",
            "required": ["stored", "usedForTraining", "processing"],
            "properties": {
              "stored": { "type": "boolean", "const": false },
              "usedForTraining": { "type": "boolean", "const": false },
              "processing": { "type": "string", "const": "transient-memory-only" }
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code", "message"],
              "properties": {
                "code": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "privacy": {
            "type": "object",
            "required": ["inputStored", "inputUsedForTraining", "externalNetworkAllowed"],
            "properties": {
              "inputStored": { "type": "boolean", "const": false },
              "inputUsedForTraining": { "type": "boolean", "const": false },
              "externalNetworkAllowed": { "type": "boolean", "const": false }
            }
          },
          "model": {
            "type": "object",
            "additionalProperties": true
          },
          "candidateCount": {
            "type": "integer",
            "minimum": 0
          },
          "matchedCandidateCount": {
            "type": "integer",
            "minimum": 0
          },
          "processingMs": {
            "type": "number"
          },
          "query": {
            "type": "object"
          },
          "panelCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          },
          "panelLayout": {
            "$ref": "#/components/schemas/PanelLayout"
          },
          "panelDetection": {
            "type": "object",
            "required": ["fallbackUsed", "readingOrder", "detectedPanelCount", "rejectedNonChartCount", "analyzedPanelCount", "maxPanels", "truncated"],
            "properties": {
              "fallbackUsed": {
                "type": "boolean"
              },
              "readingOrder": {
                "type": "string",
                "const": "top-to-bottom-left-to-right"
              },
              "detectedPanelCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of credible panels detected before applying the analysis limit."
              },
              "rejectedNonChartCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of axis-like candidates excluded because no coherent distribution Curve was present."
              },
              "analyzedPanelCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 30,
                "description": "Number of panels independently analyzed and returned in panels."
              },
              "maxPanels": {
                "type": "integer",
                "const": 30,
                "description": "Maximum number of chart panels analyzed from one image."
              },
              "truncated": {
                "type": "boolean",
                "description": "True when detectedPanelCount exceeded maxPanels and lower-confidence panels were omitted."
              }
            }
          },
          "panels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "$ref": "#/components/schemas/PanelSearchResult"
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "id", "score", "scorePercent", "imageUrl"],
              "properties": {
                "rank": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Calibrated shape similarity, not a probability."
                },
                "scorePercent": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "imageUrl": {
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "sourceImageUrl": {
                  "type": ["string", "null"],
                  "format": "uri"
                },
                "scores": {
                  "type": "object",
                  "description": "Curve, peak, valley, tail, and retrieval score components."
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "PanelLayout": {
        "type": "object",
        "required": ["rows", "columns"],
        "properties": {
          "rows": {
            "type": "integer",
            "minimum": 1
          },
          "columns": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "PanelBounds": {
        "type": "object",
        "required": ["x", "y", "width", "height"],
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0
          },
          "y": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "PanelSearchResult": {
        "type": "object",
        "required": ["panelIndex", "bounds", "confidence", "detectionReason", "axisMode", "seriesCount", "selectedSeriesIndex", "series", "query", "matchedCandidateCount", "results"],
        "properties": {
          "panelIndex": {
            "type": "integer",
            "minimum": 0
          },
          "bounds": {
            "type": "object",
            "required": ["processed", "source", "normalized"],
            "properties": {
              "processed": {
                "$ref": "#/components/schemas/PanelBounds"
              },
              "source": {
                "$ref": "#/components/schemas/PanelBounds"
              },
              "normalized": {
                "$ref": "#/components/schemas/PanelBounds"
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "detectionReason": {
            "type": "string"
          },
          "axisMode": {
            "type": "string"
          },
          "seriesCount": {
            "type": "integer",
            "minimum": 1,
            "description": "Number of independently extracted waveform series inside this physical chart panel."
          },
          "selectedSeriesIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "Representative most-irregular series mirrored by the compatibility query/results fields."
          },
          "series": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SeriesSearchResult"
            }
          },
          "query": {
            "type": "object"
          },
          "matchedCandidateCount": {
            "type": "integer"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "SeriesSearchResult": {
        "type": "object",
        "required": ["seriesIndex", "sourceIndex", "selected", "separationMode", "irregularityScore", "query", "matchedCandidateCount", "results"],
        "properties": {
          "seriesIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "Zero-based independent waveform series index inside the panel."
          },
          "sourceIndex": {
            "type": "integer",
            "minimum": 0,
            "description": "Internal color or geometry candidate index used during extraction."
          },
          "selected": {
            "type": "boolean",
            "description": "True for the most-irregular representative retained by compatibility fields."
          },
          "separationMode": {
            "type": "string",
            "enum": ["color", "achromatic", "geometry", "chromatic-union", "single"]
          },
          "irregularityScore": {
            "type": "number",
            "minimum": 0
          },
          "query": {
            "type": "object"
          },
          "matchedCandidateCount": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "reasonCode": {
                "type": "string",
                "description": "Machine-readable detailed reason. The legacy error.code remains stable for existing clients."
              },
              "details": {
                "$ref": "#/components/schemas/DiagnosticDetails"
              }
            }
          }
        }
      },
      "DiagnosticDetails": {
        "type": "object",
        "required": [
          "category",
          "diagnosticCode",
          "reason",
          "action",
          "diagnostics"
        ],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "input",
              "waveform_detection"
            ]
          },
          "legacyCode": {
            "type": "string",
            "description": "Compatibility error code retained at error.code."
          },
          "reason": {
            "type": "string",
            "enum": [
              "image_required",
              "unsupported",
              "decode_failed",
              "resource_limit",
              "no_foreground",
              "low_resolution_insufficient",
              "table_lattice_dominant",
              "no_coherent_waveform",
              "candidates_rejected",
              "candidates_ambiguous"
            ]
          },
          "diagnosticCode": {
            "type": "string",
            "pattern": "^VTH-(IN|DETECT)-[A-Z-]+$",
            "example": "VTH-DETECT-TABLE-LATTICE"
          },
          "message": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "description": "Suggested corrective action suitable for displaying directly to the user."
          },
          "diagnostics": {
            "type": "object",
            "description": "Compact numeric/boolean detector evidence such as input dimensions, foreground ratio, candidate counts, source scale, and table-lattice flags.",
            "additionalProperties": {
              "type": [
                "number",
                "boolean",
                "string"
              ]
            }
          }
        }
      },
      "TrainingSampleInput": {
        "type": "object",
        "required": [
          "id",
          "imageDataUrl",
          "sourceImageDataUrl",
          "profile",
          "descriptor"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "const": 1
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "imageDataUrl": {
            "type": "string",
            "description": "Compatibility input only. The server discards this caller-controlled preview and generates the stored standardized SVG from the verified source waveform."
          },
          "sourceImageDataUrl": {
            "type": "string",
            "description": "Required PNG/JPEG provenance preview. Ready ingestion verifies one isolated distribution waveform, then stores a server-derived profile, descriptor, State, and standardized SVG from this source; raw image-only uploads remain pending."
          },
          "profile": {
            "type": "array",
            "minItems": 256,
            "maxItems": 256,
            "items": {
              "type": "number"
            }
          },
          "descriptor": {
            "type": "object",
            "required": [
              "stateCount",
              "peakLocations",
              "peakWidths",
              "valleyHeights",
              "valleyLocations",
              "valleyDepths",
              "valleyPositionRatios",
              "peakValleyDistances",
              "tailSlopes",
              "area"
            ]
          }
        }
      }
    }
  }
}
